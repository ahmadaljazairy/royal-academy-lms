# Enforce strict peer dependency resolution to prevent silent version drift
auto-install-peers=true
strict-peer-dependencies=false

# Prevent hoisted node_modules contamination (eliminates phantom dependencies)
shamefully-hoist=false
hoist-pattern[]=*eslint*
hoist-pattern[]=*prettier*

# Engine discipline
engine-strict=true

# Link workspace packages directly using symlinks
link-workspace-packages=true
prefer-workspace-packages=true
enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  displayName     String
  passwordHash    String
  role            Role      @default(STUDENT)
  isEmailVerified Boolean   @default(false)
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  auditLogs SecurityAuditLog[]

  @@map("users")
}

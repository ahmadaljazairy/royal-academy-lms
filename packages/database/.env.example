# ==============================================================================
# Database Package Environment Configuration (@template/database)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Environment
# ------------------------------------------------------------------------------
# Controls query logging verbosity and singleton caching on globalThis.
# Options: 'development' | 'test' | 'production'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Relational Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Fully qualified connection URI parsed by @prisma/adapter-pg and pg.Pool.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>?schema=<SCHEMA>
#
# Note: Port 5433 is assigned to avoid port collisions with host-level PostgreSQL
# instances running on standard port 5432.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/royal_academy_db?schema=public"

# ------------------------------------------------------------------------------
# 3. Connection Pool Configuration (pg.Pool Tuning)
# ------------------------------------------------------------------------------
# Maximum number of persistent TCP connections allocated in the pool per process.
# Keep lower (5-10) in development to avoid exhausting PostgreSQL max_connections
# when running multiple services (API, workers, seeds) concurrently.
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 4. Database Seeding Security (seed.ts)
# ------------------------------------------------------------------------------
# Seed password used to create the default platform administrator account:
# Email: admin@royalacademy.com
#
# SECURITY WARNING: This plaintext value is hashed using Argon2id during `db:seed`.
# Change this immediately when bootstrapping staging or production environments.
ADMIN_SEED_PASSWORD="mpmjj4luI2o/8MYowny+2Q=="
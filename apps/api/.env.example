# -----------------------------------------------------------------------------
# Application Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/royal_academy_db"

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Primary Connection String (Recommended)
# Format: redis://[:password]@<host>:<port>/[db_number]
# TLS Format: rediss://[:password]@<host>:<port>/[db_number]
#
# Examples:
# - Local Host:      redis://localhost:6379
# - Docker Compose:  redis://redis:6379
# - Password Auth:   redis://:secret_pass@localhost:6379/0
# - Managed Cloud:   rediss://:secret_pass@cache.amazonaws.com:6379
REDIS_URL=redis://localhost:6379

# Fallback / Discrete Connection Parameters
# Used automatically if REDIS_URL is omitted or empty.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# -----------------------------------------------------------------------------
# Session Lifespans (Hours)
# -----------------------------------------------------------------------------
# Standard session lifespan (24 hours)
SESSION_STANDARD_TTL_HOURS=24

# Persistent session lifespan for "Remember Me" (30 days)
SESSION_REMEMBER_ME_TTL_HOURS=720

# -----------------------------------------------------------------------------
# Perimeter & CORS
# Comma-separated list of allowed client origins (no trailing slashes)
# -----------------------------------------------------------------------------
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# -----------------------------------------------------------------------------
# SMTP / Mailpit Configuration
# -----------------------------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Royal Academy <no-reply@royalacademy.com>"
APP_URL=http://localhost:3000
WEB_APP_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# S3 / MinIO Storage Configuration
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_PUBLIC_BUCKET_NAME=royal-academy-public
S3_PRIVATE_BUCKET_NAME=royal-academy-private
S3_FORCE_PATH_STYLE=true
# S3_CDN_URL=https://cdn.royalacademy.com # Optional in dev, used in production